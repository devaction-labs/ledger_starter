<div class="bg-page text-ink">
  <.toaster flash={@flash} close_label={gettext("Fechar")} />
  <.landing_nav id="sk-nav">
    <:logo>
      <.link navigate={~p"/"} aria-label="StartKit"><.brand_logo /></.link>
    </:logo>
    <:link label={gettext("Produto")} href="#recursos" />
    <:link label={gettext("Multiempresa")} href="#workspaces" />
    <:link label={gettext("Preços")} href="#precos" />
    <:link label="Docs" href="https://github.com/devaction-labs/ledger_starter#readme" />
    <:actions>
      <.locale_switcher />
      <.landing_login navigate={~p"/users/log-in"}>{gettext("Entrar")}</.landing_login>
      <.landing_cta navigate={~p"/users/register"}>{gettext("Começar grátis")}</.landing_cta>
    </:actions>
    <:signed_in :if={@current_scope && @current_scope.user}>
      <.landing_cta navigate={~p"/workspaces"}>{gettext("Abrir workspace")}</.landing_cta>
    </:signed_in>
  </.landing_nav>

  <section class="mx-auto flex max-w-[1180px] flex-col items-center gap-6 px-8 pt-20 pb-14 text-center">
    <.badge dot>{gettext("Novo · login com Google e convites por link")}</.badge>
    <h1 class="m-0 max-w-[860px] font-display text-[60px] leading-[1.04] font-bold tracking-[-.045em]">
      {gettext("O CRM pronto para virar o seu SaaS")}
    </h1>
    <p class="m-0 max-w-[640px] text-[18px] leading-relaxed text-muted">
      {gettext(
        "Contatos e funil de vendas, com uma empresa por workspace, time com papéis e limite de assentos. Clone, troque a marca e publique."
      )}
    </p>
    <div class="flex gap-3">
      <.button navigate={~p"/users/register"} size="lg" trailing_icon="arrow-right">
        {gettext("Criar meu workspace")}
      </.button>
      <.button
        href="https://github.com/devaction-labs/ledger_starter"
        size="lg"
        variant="outline"
        icon="github"
      >
        {gettext("Ver no GitHub")}
      </.button>
    </div>
    <span class="text-[13px] text-muted">
      {gettext("14 dias grátis · sem cartão · Phoenix + LiveView + Ledger UI")}
    </span>
  </section>

  <section class="mx-auto max-w-[1180px] px-8 pb-20">
    <div class="rounded-[28px] border border-line bg-tray p-3 shadow-lg">
      <div class="flex flex-col gap-4 rounded-[20px] border border-line bg-panel p-6">
        <.hero_card
          id="sk-land-hero"
          eyebrow={gettext("Bom dia, Alex")}
          title={gettext("Novembro está 12% acima de outubro")}
          meta={gettext("Meta de novembro")}
          meta_value={gettext("R$ 184 mil de R$ 250 mil")}
          meter={74}
        />
        <div class="grid grid-cols-4 gap-3">
          <.mini_card
            surface="card"
            icon="user-plus"
            tone="accent"
            label={gettext("Novo contato")}
          />
          <.mini_card surface="card" icon="kanban" tone="info" label={gettext("Novo negócio")} />
          <.mini_card
            surface="card"
            icon="calendar"
            tone="warning"
            label={gettext("Agendar reunião")}
          />
          <.mini_card surface="card" icon="mail" tone="success" label={gettext("Enviar e-mail")} />
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto flex max-w-[1180px] flex-col gap-10 px-8 pb-24" id="recursos">
    <div class="flex flex-col gap-3">
      <span class="font-mono text-xs tracking-[.08em] text-accent-content uppercase">
        {gettext("O que vem no kit")}
      </span>
      <h2 class="m-0 max-w-[640px] font-display text-[38px] leading-[1.1] font-bold tracking-[-.03em]">
        {gettext("Tudo que todo SaaS precisa antes da primeira venda")}
      </h2>
    </div>
    <div class="grid grid-cols-3 gap-4">
      <.card :for={f <- features()}>
        <div class="flex flex-col gap-3">
          <.icon boxed name={f.icon} />
          <b class="text-[16px]">{f.title}</b>
          <p class="m-0 text-muted">{f.text}</p>
        </div>
      </.card>
    </div>
  </section>

  <section class="bg-shell py-20" id="workspaces">
    <div class="mx-auto grid max-w-[1180px] grid-cols-2 items-center gap-12 px-8">
      <div class="flex flex-col gap-4">
        <span class="font-mono text-xs tracking-[.08em] text-accent-content uppercase">
          {gettext("Multi-tenant de verdade")}
        </span>
        <h2 class="m-0 font-display text-[38px] leading-[1.1] font-bold tracking-[-.03em]">
          {gettext("Uma conta, várias empresas")}
        </h2>
        <p class="m-0 text-[16px] leading-relaxed text-muted">
          {gettext(
            "Cada cliente do seu SaaS ganha um workspace com endereço próprio. Uma pessoa pode estar em vários e trocar sem sair."
          )}
        </p>
        <.steps color="primary">
          <:step label={gettext("Cria a conta")} state="done" />
          <:step label={gettext("Cria a empresa")} state="done" />
          <:step label={gettext("Convida o time")} state="current" />
        </.steps>
      </div>
      <div class="flex flex-col gap-2.5 rounded-[24px] border border-line bg-panel p-5">
        <span class="text-xs text-muted uppercase tracking-[.06em]">
          {gettext("Seus workspaces")}
        </span>
        <.mini_card label="Orbit Cloud" icon="building">
          orbit.{@base_host} · {gettext("Dono")}
        </.mini_card>
        <.mini_card label="Bompreço Atacado" icon="building">
          bompreco.{@base_host} · {gettext("Admin")}
        </.mini_card>
        <.mini_card label="Lumen Studio" icon="building">
          lumen.{@base_host} · {gettext("Membro")}
        </.mini_card>
      </div>
    </div>
  </section>

  <section class="mx-auto flex max-w-[1180px] flex-col items-center gap-10 px-8 py-24" id="precos">
    <div class="flex flex-col items-center gap-3 text-center">
      <span class="font-mono text-xs tracking-[.08em] text-accent-content uppercase">
        {gettext("Preços")}
      </span>
      <h2 class="m-0 font-display text-[38px] leading-[1.1] font-bold tracking-[-.03em]">
        {gettext("Cobre por assento desde o primeiro dia")}
      </h2>
    </div>
    <div class="grid w-full grid-cols-3 gap-4">
      <.card :for={plan <- plans()}>
        <div class="flex flex-col gap-4">
          <div class="flex items-center justify-between">
            <b class="text-[16px]">{plan.name}</b>
            <.badge :if={plan[:badge]}>{plan.badge}</.badge>
          </div>
          <div class="flex items-baseline gap-1.5">
            <span class="font-display text-[34px] font-bold tracking-[-.03em]">{plan.price}</span>
            <span class="text-muted">{plan.note}</span>
          </div>
          <ul class="m-0 flex list-none flex-col gap-2 p-0">
            <li :for={item <- plan.items} class="flex items-center gap-2">
              <.icon name="check" class="text-accent-content" />{item}
            </li>
          </ul>
          <.button
            navigate={~p"/users/register"}
            variant={if plan[:badge], do: "solid", else: "outline"}
          >
            {plan.cta}
          </.button>
        </div>
      </.card>
    </div>
  </section>

  <section class="mx-auto max-w-[1180px] px-8 pb-20">
    <.hero_card
      id="sk-cta"
      eyebrow={gettext("Seu SaaS em uma tarde")}
      title={gettext("Clone o StartKit e venda na segunda-feira")}
      description={
        gettext("Phoenix 1.8, LiveView, Ledger UI, Postgres com tenants e deploy pronto.")
      }
    >
      <:actions>
        <.button navigate={~p"/users/register"} trailing_icon="arrow-right">
          {gettext("Criar meu workspace")}
        </.button>
        <.button
          href="https://github.com/devaction-labs/ledger_starter"
          variant="outline"
          icon="github"
        >
          {gettext("Usar o template")}
        </.button>
      </:actions>
    </.hero_card>
  </section>

  <footer class="border-t border-line">
    <div class="mx-auto flex max-w-[1180px] items-center justify-between px-8 py-8 text-[13px] text-muted">
      <span class="flex items-center gap-2.5"><.brand_logo size={22} class="text-[15px] text-ink" />
      © 2026</span>
      <span class="flex gap-5">
        <a href="https://github.com/devaction-labs/ledger_starter#readme">Docs</a>
        <a href="https://github.com/devaction-labs/ledger_starter">GitHub</a>
        <a href={~p"/privacidade"}>{gettext("Privacidade")}</a>
        <a href={~p"/termos"}>{gettext("Termos")}</a>
      </span>
    </div>
  </footer>
</div>
